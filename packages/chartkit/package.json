{
  "name": "generative-charts",
  "version": "0.2.0",
  "description": "Polished, accessible React charts with expressive themes.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css && cp src/styles.css.d.ts dist/styles.css.d.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Kasturi Khanke",
  "keywords": [
    "react",
    "charts",
    "data-visualization",
    "typescript",
    "svg",
    "accessible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasturikhanke/generativecharts.git",
    "directory": "packages/chartkit"
  },
  "homepage": "https://generativecharts.com",
  "bugs": {
    "url": "https://github.com/kasturikhanke/generativecharts/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/kasturibuilds"
  }
}
