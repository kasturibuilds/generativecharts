{
  "name": "chartkit-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm run build:package && next dev",
    "build:package": "npm run build --workspace @chartkit/internal",
    "build": "npm run build:package && next build",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @chartkit/internal",
    "lint": "eslint . --ignore-pattern packages/chartkit/dist --ignore-pattern .next",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:consumers": "node scripts/test-consumers.mjs",
    "test": "npm run build:package && npm run typecheck && npm run test:unit && npm run build",
    "pack:package": "npm_config_cache=/tmp/chartkit-npm-cache npm pack --workspace @chartkit/internal --dry-run"
  },
  "dependencies": {
    "@chartkit/internal": "workspace:*",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.1.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "engines": { "node": ">=20" }
}
